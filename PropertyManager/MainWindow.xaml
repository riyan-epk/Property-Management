<Window x:Class="PropertyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PropertyManager.ViewModels"
        Title="Property &amp; Rent Management System" 
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        MaxHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}}"
        MaxWidth="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}}"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="#1E1F36" Padding="12,16">
            <DockPanel>
                <!-- App Logo/Title -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <TextBlock Text="🏠" FontSize="28" Margin="0,0,0,4"/>
                    <TextBlock Text="Property Manager" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Rent Management System" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="MAIN MENU" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,10"
                               Opacity="0.7"/>

                    <Button Content="📊  Dashboard" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToDashboardCommand}" Margin="0,2"/>
                    <Button Content="🏢  Properties" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToPropertiesCommand}" Margin="0,2"/>
                    <Button Content="👤  Tenants" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToTenantsCommand}" Margin="0,2"/>
                    <Button Content="📄  Agreements" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToAgreementsCommand}" Margin="0,2"/>

                    <TextBlock Text="FINANCE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,20,0,10"
                               Opacity="0.7"/>

                    <Button Content="💡  Rent &amp; Expenses" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToExpensesCommand}" Margin="0,2"/>
                    <Button Content="💳  Payments" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToPaymentsCommand}" Margin="0,2"/>
                    <Button Content="📈  Reports" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToReportsCommand}" Margin="0,2"/>

                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,20,0,10"
                               Opacity="0.7"/>

                    <Button Content="ℹ️  About" Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateToAboutCommand}" Margin="0,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <DockPanel Grid.Column="1">
            <!-- Header Bar -->
            <Border DockPanel.Dock="Top" Background="#1E1F36" Padding="24,12" Margin="0,0,0,0">
                <TextBlock Text="{Binding CurrentViewTitle}" 
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <!-- Page Content with smooth scrolling -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,14"
                          CanContentScroll="False"
                          Focusable="False"
                          PanningMode="VerticalOnly">
                <ContentControl Content="{Binding CurrentViewModel}" Focusable="False"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
