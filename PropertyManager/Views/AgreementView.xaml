<UserControl x:Class="PropertyManager.Views.AgreementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PropertyManager.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ TOP: Agreement Form ════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="📄 Create / Edit Agreement" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Basic Info -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Label Content="Select Tenant"/>
                        <ComboBox ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant}"
                                  DisplayMemberPath="Name" Margin="0,0,0,10"/>

                        <Label Content="Select Unit"/>
                        <ComboBox ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding SelectedUnit}"
                                  DisplayMemberPath="UnitNumber" Margin="0,0,0,10"/>

                        <Label Content="Base Rent (Rs.)"/>
                        <TextBox Text="{Binding BaseRent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" KeyDown="FormField_KeyDown"/>
                    </StackPanel>

                    <!-- Column 2: Dates -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <Label Content="Start Date"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,10"/>

                        <Label Content="End Date"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Column 3: Rent Increase Settings (KEY FEATURE) -->
                    <StackPanel Grid.Column="2">
                        <Border Background="#FBF1E2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📈 Rent Increase Rules" FontSize="13" FontWeight="SemiBold" 
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Per-Agreement Settings" FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <Label Content="Increase Type"/>
                                <ComboBox SelectedItem="{Binding IncreaseType}" Margin="0,0,0,10">
                                    <models:IncreaseType>Monthly</models:IncreaseType>
                                    <models:IncreaseType>Yearly</models:IncreaseType>
                                    <models:IncreaseType>CustomMonths</models:IncreaseType>
                                </ComboBox>

                                <Label Content="Increase After (Months)"/>
                                <TextBox Text="{Binding IncreaseAfterMonths, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,10" KeyDown="FormField_KeyDown"/>

                                <Label Content="Increase Percentage (%)"/>
                                <TextBox Text="{Binding IncreasePercentage, UpdateSourceTrigger=PropertyChanged}" KeyDown="FormField_KeyDown"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveAgreementCommand}" Margin="0,0,8,0">
                        <TextBlock Text="💾 Save Agreement"/>
                    </Button>
                    <Button Content="✏ Edit Selected" Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditAgreementCommand}" Margin="0,0,8,0"/>
                    <Button Content="🗑 Delete" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteAgreementCommand}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ════════ BOTTOM: Agreements List ════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,4,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="📋 Agreements" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            Command="{Binding PrintAgreementCommand}"
                            ToolTip="Print the selected agreement (Mohada / معاہدہ)">
                        <TextBlock Text="🖨 Print Agreement (معاہدہ)"/>
                    </Button>
                </Grid>
                <DataGrid ItemsSource="{Binding Agreements}" SelectedItem="{Binding SelectedAgreement}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant.Name}" Width="120"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit.UnitNumber}" Width="70"/>
                        <DataGridTextColumn Header="Property" Binding="{Binding Unit.Property.Name}" Width="120"/>
                        <DataGridTextColumn Header="Base Rent" Binding="{Binding BaseRent, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="Increase" Binding="{Binding IncreaseType}" Width="80"/>
                        <DataGridTextColumn Header="Every (Mo)" Binding="{Binding IncreaseAfterMonths}" Width="72"/>
                        <DataGridTextColumn Header="%" Binding="{Binding IncreasePercentage}" Width="45"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
