<Window x:Class="PropertyManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PropertyManager.ViewModels"
        Title="Property Manager — Login" 
        Width="450" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Border Background="#FFFDF8" CornerRadius="16" Margin="10"
            BorderBrush="#E4D9C4" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#8A2E3B"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar (draggable) -->
            <Border Grid.Row="0" Background="#6E2430" CornerRadius="16,16,0,0"
                    Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Property Manager" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F3E7D8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                            Foreground="#D9B7AE" FontSize="16" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click" Padding="4,0"/>
                </Grid>
            </Border>

            <!-- Login Form -->
            <StackPanel Grid.Row="1" Margin="40,32,40,40" VerticalAlignment="Center">
                <TextBlock Text="🔐" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Welcome Back" FontSize="22" FontWeight="Bold"
                           Foreground="#8A2E3B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to continue" FontSize="12"
                           Foreground="#8A7D6B" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Error Message -->
                <Border Background="#FBEBE8" BorderBrush="#E7B9B2" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Username" Foreground="#8A7D6B" FontSize="12" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" FontSize="14"/>

                <!-- Password -->
                <TextBlock Text="Password" Foreground="#8A7D6B" FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,24" FontSize="14"
                             Background="#FBF6EC" Foreground="#2C2620"
                             BorderBrush="#E4D9C4" BorderThickness="1"
                             Padding="10,8" CaretBrush="#2C2620"
                             KeyDown="PasswordBox_KeyDown">
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#8A2E3B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>

                <!-- Login Button — uses Click handler to pass password from code-behind -->
                <Button Style="{StaticResource PrimaryButton}" Content="🔓  Sign In"
                        FontSize="14" Padding="20,12"
                        Click="LoginButton_Click"/>

                <!-- Credential Hint -->
              
            </StackPanel>
        </Grid>
    </Border>
</Window>
