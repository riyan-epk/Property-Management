<UserControl x:Class="PropertyManager.Views.PropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════ LEFT: Property Management ════════ -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <!-- Add/Edit Property Form -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14">
                        <Run Text="{Binding IsEditingProperty, StringFormat={}{0}}"/>
                        <Run Text="➕ Add Property"/>
                    </TextBlock>

                    <Label Content="Property Name"/>
                    <TextBox Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" KeyDown="PropertyField_KeyDown"/>

                    <Label Content="Location"/>
                    <TextBox Text="{Binding PropertyLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" KeyDown="PropertyField_KeyDown"/>

                    <Label Content="Type"/>
                    <ComboBox ItemsSource="{Binding PropertyTypes}" 
                              SelectedItem="{Binding PropertyType}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePropertyCommand}" Margin="0,0,8,0">
                            <TextBlock Text="💾 Save Property"/>
                        </Button>
                        <Button Content="✏ Edit Selected" Style="{StaticResource SecondaryButton}"
                                Command="{Binding EditPropertyCommand}" Margin="0,0,8,0"/>
                        <Button Content="🗑 Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeletePropertyCommand}"/>
                    </StackPanel>
                    <Button Content="Cancel Edit" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding CancelEditPropertyCommand}" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsEditingProperty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Properties DataGrid -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="📋 Properties List" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Properties}" 
                              SelectedItem="{Binding SelectedProperty}"
                              MaxHeight="350">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ════════ RIGHT: Unit Management ════════ -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <!-- Add/Edit Unit Form -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="🏠 Add Unit" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14">
                        <Run Text="For: "/>
                        <Run Text="{Binding SelectedProperty.Name, FallbackValue='Select a property', Mode=OneWay}"/>
                    </TextBlock>

                    <Label Content="Unit Number"/>
                    <TextBox Text="{Binding UnitNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" KeyDown="UnitField_KeyDown"/>

                    <Label Content="Base Rent (Rs.)"/>
                    <TextBox Text="{Binding UnitBaseRent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" KeyDown="UnitField_KeyDown"/>

                    <Label Content="Status"/>
                    <ComboBox ItemsSource="{Binding UnitStatuses}" 
                              SelectedItem="{Binding UnitStatus}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveUnitCommand}" Margin="0,0,8,0">
                            <TextBlock Text="💾 Save Unit"/>
                        </Button>
                        <Button Content="🗑 Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteUnitCommand}" 
                                CommandParameter="{Binding SelectedItem, ElementName=UnitsGrid}"/>
                    </StackPanel>
                    <Button Content="Cancel Edit" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding CancelEditUnitCommand}" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsEditingUnit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Units DataGrid -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="📋 Units" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="UnitsGrid" ItemsSource="{Binding Units}" MaxHeight="350">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unit #" Binding="{Binding UnitNumber}" Width="80"/>
                            <DataGridTextColumn Header="Base Rent" Binding="{Binding BaseRent, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏" FontSize="14" Cursor="Hand"
                                                Background="Transparent" Foreground="{StaticResource PrimaryBrush}" 
                                                BorderThickness="0"
                                                Command="{Binding DataContext.EditUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
