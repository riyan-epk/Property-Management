<UserControl x:Class="PropertyManager.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <!-- Center the card on the screen -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="40"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Width="400"
                Margin="0,0,0,50">
            <Border.Effect>
                <DropShadowEffect Color="#B59B6A" BlurRadius="20" Opacity="0.3" Direction="270" ShadowDepth="6" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- Avatar Icon -->
                <Ellipse Width="100" Height="100" Fill="{StaticResource BgDarkBrush}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="3" Margin="0,0,0,20">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#8A2E3B" BlurRadius="10" Opacity="0.25" ShadowDepth="0" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="👤" FontSize="50" HorizontalAlignment="Center" Margin="0,-95,0,0" Foreground="{StaticResource AccentBrush}" IsHitTestVisible="False"/>
                
                <!-- Title -->
                <TextBlock Text="Developer Profile" FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,40,0,8" />
                
                <!-- Name -->
                <TextBlock Text="{Binding DeveloperName}" FontSize="28" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                
                <!-- Role -->
                <TextBlock Text="{Binding Role}" FontSize="16" FontWeight="Medium" 
                           Foreground="{StaticResource AccentBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,24" />
                
                <!-- Separator -->
                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,24" />

                <!-- Contact Details Card inside -->
                <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📞" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Contact Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ContactNumber}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Additional footer text -->
                <TextBlock Text="Property &amp; Rent Management System" FontSize="11" FontWeight="Regular" 
                           Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6"
                           HorizontalAlignment="Center" Margin="0,30,0,15" />
                           
                <!-- Backup & Restore Database -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="12,8"
                            Command="{Binding BackupDatabaseCommand}">
                        <TextBlock Text="💾 Backup Database"/>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Padding="12,8"
                            Command="{Binding RestoreDatabaseCommand}">
                        <TextBlock Text="🔄 Restore Database"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
